{
  "name": "af_forum-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "二叉树树论坛的独立前端（纯 CSR，只含论坛路由）",
  "scripts": {
    "dev": "node scripts/build-icon-subset.mjs && vite",
    "build": "node scripts/build-icon-subset.mjs && tsc --noEmit && vite build && node scripts/build-feeds.mjs",
    "preview": "vite preview",
    "typecheck": "node scripts/build-icon-subset.mjs && tsc --noEmit"
  },
  "//": "pnpm 10 默认不执行依赖的 install/build 脚本，未批准的构建会让 pnpm install 以 ERR_PNPM_IGNORED_BUILDS 退出 1（CI 直接失败）。等价于本地 pnpm approve-builds，但必须写进仓库才对 CI 生效。",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.1.1",
    "@fontsource-variable/geist-mono": "^5.1.1",
    "@iconify/react": "^6.0.2",
    "@marsidev/react-turnstile": "^1.5.3",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.3.0",
    "mermaid": "^11.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.91",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
