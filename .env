# 部署基路径。空 = 站点根（独立子域名，/post/19）；设成 /forum 则沿用主站老 URL。
# 改这里等于同时改了 vite 的 base 与 React Router 的 basename。
VITE_BASE_PATH=

# 本站对外地址，用于 canonical / og:url / JSON-LD。**部署前必须改成真实域名**，
# 写错不会报错，只会让搜索引擎收录到一个不存在的地址。
VITE_SITE_URL=https://bbs.acofork.com

# 论坛后端。浏览器直连（后端 CORS 是 *），不再经主站的 /forum/api 代理。
VITE_FORUM_API_BASE=https://i.2x.nz

# 头像/封面缩略图服务（主站 VPS 上的 thumbs.js）。留空则直接用原图 URL。
VITE_THUMB_BASE=https://2x.nz

# 分享卡片默认图
VITE_OG_IMAGE=https://2x.nz/files/img/official.png
